{
 "trailingSlash": false,
 "rewrites": [
  {
   "source": "/flower/:n(\\d+)",
   "destination": "/index.html"
  },
  {
   "source": "/privacy",
   "destination": "/privacy.html"
  },
  {
   "source": "/imprint",
   "destination": "/imprint.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    }
   ]
  },
  {
   "source": "/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}